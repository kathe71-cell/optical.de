{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "optical.de"
        }
      ],
      "destination": "https://www.optical.de/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "optical-de.vercel.app"
        }
      ],
      "destination": "https://www.optical.de/$1",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#trust",
      "permanent": true
    },
    {
      "source": "/decoder",
      "destination": "/eigenmarken-decoder",
      "permanent": true
    },
    {
      "source": "/rechner",
      "destination": "/preisrechner",
      "permanent": true
    },
    {
      "source": "/bookmarks",
      "destination": "/meine-linsen",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/rechner-embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}